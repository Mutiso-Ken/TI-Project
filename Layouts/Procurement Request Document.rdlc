            <Textbox Name="ApprovalChainBox">
              <CanGrow>true</CanGrow>
              <Top>9.1cm</Top>
              <Left>0cm</Left>
              <Height>4.6cm</Height>
              <Width>19cm</Width>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value EvaluationMode="Auto">="Approval Chain" &amp; vbCrLf &amp; "Sent By: " &amp; First(Fields!SenderID.Value,"DataSet_Result") &amp; "   Sent On: " &amp; First(Fields!DateTimeSend.Value,"DataSet_Result") &amp; vbCrLf &amp; "Level 1 Approver: " &amp; First(Fields!FirstApproverID.Value,"DataSet_Result") &amp; "   Approved On: " &amp; First(Fields!DateTimeFirstApprove.Value,"DataSet_Result") &amp; vbCrLf &amp; "Level 2 Approver: " &amp; First(Fields!SecondApproverID.Value,"DataSet_Result") &amp; "   Approved On: " &amp; First(Fields!DateTimeSecondApprove.Value,"DataSet_Result") &amp; vbCrLf &amp; "Level 3 Approver: " &amp; First(Fields!ThirdApproverID.Value,"DataSet_Result") &amp; "   Approved On: " &amp; First(Fields!DateTimeThirdApprove.Value,"DataSet_Result") &amp; vbCrLf &amp; "Level 4 Approver: " &amp; First(Fields!FourthApproverID.Value,"DataSet_Result") &amp; "   Approved On: " &amp; First(Fields!DateTimeFourthApprove.Value,"DataSet_Result") &amp; vbCrLf &amp; "Level 5 Approver: " &amp; First(Fields!FifthApproverID.Value,"DataSet_Result") &amp; "   Approved On: " &amp; First(Fields!DateTimeFifthApprove.Value,"DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>8pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
