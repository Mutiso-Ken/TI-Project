            <Textbox Name="CompanyBox">
              <CanGrow>true</CanGrow>
              <Top>0.9cm</Top>
              <Left>0cm</Left>
              <Height>1.6cm</Height>
              <Width>19cm</Width>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value EvaluationMode="Auto">=First(Fields!CompanyName.Value,"DataSet_Result") &amp; vbCrLf &amp; First(Fields!CompanyAddress.Value,"DataSet_Result") &amp; vbCrLf &amp; "Tel: " &amp; First(Fields!CompanyPhone.Value,"DataSet_Result") &amp; "   Email: " &amp; First(Fields!CompanyEmail.Value,"DataSet_Result") &amp; vbCrLf &amp; First(Fields!CompanyWebsite.Value,"DataSet_Result") &amp; "   " &amp; First(Fields!CompanyPostCode.Value,"DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
              </Paragraphs>
              <rd:DefaultName>CompanyBox</rd:DefaultName>
              <Style>
                <Border>
                  <Style>None</Style>
                </Border>
              </Style>
            </Textbox>
            <Textbox Name="HeaderInfoBox">
              <CanGrow>true</CanGrow>
              <Top>2.7cm</Top>
              <Left>0cm</Left>
              <Height>6.2cm</Height>
              <Width>19cm</Width>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value EvaluationMode="Auto">="No.: " &amp; First(Fields!No_ProcurementRequest.Value,"DataSet_Result") &amp; "     Status: " &amp; First(Fields!Status_ProcurementRequest.Value,"DataSet_Result") &amp; vbCrLf &amp; "Title: " &amp; First(Fields!Title_ProcurementRequest.Value,"DataSet_Result") &amp; vbCrLf &amp; "Requisition No: " &amp; First(Fields!RequisitonNo_ProcurementRequest.Value,"DataSet_Result") &amp; "     Procurement Method: " &amp; First(Fields!ProcurementMethod_ProcurementRequest.Value,"DataSet_Result") &amp; vbCrLf &amp; "Created By: " &amp; First(Fields!CreatedBy_ProcurementRequest.Value,"DataSet_Result") &amp; "     Created On: " &amp; Format(First(Fields!CreatedOn_ProcurementRequest.Value,"DataSet_Result"),"yyyy-MM-dd") &amp; vbCrLf &amp; "Current Budget: " &amp; First(Fields!CurrentBudget_ProcurementRequest.Value,"DataSet_Result") &amp; "     Total Amount: " &amp; Format(First(Fields!TotalAmount_ProcurementRequest.Value,"DataSet_Result"),"N2") &amp; vbCrLf &amp; "Supplier Category: " &amp; First(Fields!SupplierCategory_ProcurementRequest.Value,"DataSet_Result") &amp; "     Source of Funds: " &amp; First(Fields!SourceOfFunds_ProcurementRequest.Value,"DataSet_Result") &amp; vbCrLf &amp; "Vendor: " &amp; First(Fields!VendorNo_ProcurementRequest.Value,"DataSet_Result") &amp; " - " &amp; First(Fields!VendorName_ProcurementRequest.Value,"DataSet_Result") &amp; vbCrLf &amp; "Expected Delivery Date: " &amp; Format(First(Fields!ExpectedDeliveryDate_ProcurementRequest.Value,"DataSet_Result"),"yyyy-MM-dd") &amp; "     RFQ Deadline: " &amp; Format(First(Fields!RFQDeadlineDate_ProcurementRequest.Value,"DataSet_Result"),"yyyy-MM-dd") &amp; " " &amp; Format(First(Fields!RFQDeadlineTime_ProcurementRequest.Value,"DataSet_Result"),"HH:mm") &amp; vbCrLf &amp; "Dimensions: " &amp; First(Fields!GlobalDimension1Code_ProcurementRequest.Value,"DataSet_Result") &amp; " / " &amp; First(Fields!GlobalDimension2Code_ProcurementRequest.Value,"DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>8pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
