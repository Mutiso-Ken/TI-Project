              <CanGrow>true</CanGrow>
              <Top>0cm</Top>
              <Left>0cm</Left>
              <Height>0.8cm</Height>
              <Width>19cm</Width>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value EvaluationMode="Auto">Purchase Requisition Document</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>14pt</FontSize>
                        <FontWeight>Bold</FontWeight>
                      </Style>
                    </TextRun>
                  </TextRuns>
