            <Textbox Name="CompanyBox">
              <CanGrow>true</CanGrow>
              <Top>0.9cm</Top>
              <Left>0cm</Left>
              <Height>1.6cm</Height>
              <Width>19cm</Width>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value EvaluationMode="Auto">=First(Fields!CompanyName.Value,"DataSet_Result") &amp; vbCrLf &amp; First(Fields!CompanyAddress.Value,"DataSet_Result") &amp; vbCrLf &amp; "Tel: " &amp; First(Fields!CompanyPhone.Value,"DataSet_Result") &amp; "   Email: " &amp; First(Fields!CompanyEmail.Value,"DataSet_Result") &amp; vbCrLf &amp; First(Fields!CompanyWebsite.Value,"DataSet_Result") &amp; "   " &amp; First(Fields!CompanyPostCode.Value,"DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>9pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
              </Paragraphs>
              <rd:DefaultName>CompanyBox</rd:DefaultName>
              <Style>
                <Border>
                  <Style>None</Style>
                </Border>
              </Style>
            </Textbox>
            <Textbox Name="HeaderInfoBox">
              <CanGrow>true</CanGrow>
              <Top>2.7cm</Top>
              <Left>0cm</Left>
              <Height>6.2cm</Height>
              <Width>19cm</Width>
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value EvaluationMode="Auto">="No.: " &amp; First(Fields!No_PurchaseHeader.Value,"DataSet_Result") &amp; "     Status: " &amp; CStr(First(Fields!Status_PurchaseHeader.Value,"DataSet_Result")) &amp; vbCrLf &amp; "Title: " &amp; First(Fields!Title_PurchaseHeader.Value,"DataSet_Result") &amp; vbCrLf &amp; "Employee: " &amp; First(Fields!EmployeeNo_PurchaseHeader.Value,"DataSet_Result") &amp; " - " &amp; First(Fields!EmployeeName_PurchaseHeader.Value,"DataSet_Result") &amp; vbCrLf &amp; "Created By: " &amp; First(Fields!CreatedBy_PurchaseHeader.Value,"DataSet_Result") &amp; "     Created On: " &amp; Format(First(Fields!CreatedOn_PurchaseHeader.Value,"DataSet_Result"),"yyyy-MM-dd") &amp; vbCrLf &amp; "No. Series: " &amp; First(Fields!NoSeries_PurchaseHeader.Value,"DataSet_Result") &amp; "     Total Amount: " &amp; Format(First(Fields!TotalAmount_PurchaseHeader.Value,"DataSet_Result"),"N2") &amp; vbCrLf &amp; "Budget Code: " &amp; First(Fields!BudgetCode_PurchaseHeader.Value,"DataSet_Result") &amp; "     Supplier Category: " &amp; First(Fields!SupplierCategory_PurchaseHeader.Value,"DataSet_Result") &amp; vbCrLf &amp; "Requesting Person: " &amp; CStr(First(Fields!RequestingPerson_PurchaseHeader.Value,"DataSet_Result")) &amp; "     Project Code: " &amp; First(Fields!ProjectCode_PurchaseHeader.Value,"DataSet_Result") &amp; vbCrLf &amp; "Requested Receipt Date: " &amp; Format(First(Fields!RequestedReceiptDate_PurchaseHeader.Value,"DataSet_Result"),"yyyy-MM-dd") &amp; vbCrLf &amp; "Approval Entries: " &amp; CStr(First(Fields!ApprovalEntries_PurchaseHeader.Value,"DataSet_Result")) &amp; "     Process Initiated: " &amp; IIF(First(Fields!ProcessInitiated_PurchaseHeader.Value,"DataSet_Result"),"Yes","No") &amp; vbCrLf &amp; "Posted: " &amp; IIF(First(Fields!Posted_PurchaseHeader.Value,"DataSet_Result"),"Yes","No") &amp; "     Posted By: " &amp; First(Fields!PostedBy_PurchaseHeader.Value,"DataSet_Result") &amp; "     Posted On: " &amp; Format(First(Fields!PostedOn_PurchaseHeader.Value,"DataSet_Result"),"yyyy-MM-dd") &amp; vbCrLf &amp; "Posting Date: " &amp; Format(First(Fields!PostingDate_PurchaseHeader.Value,"DataSet_Result"),"yyyy-MM-dd") &amp; "     Time Posted: " &amp; Format(First(Fields!TimePosted_PurchaseHeader.Value,"DataSet_Result"),"HH:mm") &amp; vbCrLf &amp; "Dimensions: " &amp; First(Fields!ShortcutDimension1Code_PurchaseHeader.Value,"DataSet_Result") &amp; " / " &amp; First(Fields!ShortcutDimension2Code_PurchaseHeader.Value,"DataSet_Result") &amp; " / " &amp; First(Fields!ShortcutDimension3Code_PurchaseHeader.Value,"DataSet_Result")</Value>
                      <Style>
                        <FontFamily>Segoe UI</FontFamily>
                        <FontSize>8pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
              </Paragraphs>
              <rd:DefaultName>HeaderInfoBox</rd:DefaultName>
              <Style>
                <Border>
                  <Style>None</Style>
                </Border>
              </Style>
