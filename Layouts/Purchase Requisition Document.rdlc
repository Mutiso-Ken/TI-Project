            <Textbox Name="ApprovalChainBox">
              <CanGrow>true</CanGrow>
              <Top>9.1cm</Top>
              <Left>0cm</Left>
              <Height>4.6cm</Height>
              <Width>19cm</Width>
              <Paragraphs>
